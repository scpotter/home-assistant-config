#!/usr/bin/env bash
# Slice 7a Plan C -- pre-push gate for home-assistant-config.
#
# yamllint only, scoped to the files this push actually changes (not the
# whole tree -- pre-existing content, e.g. third-party blueprint YAML, is
# already live per SPEC's "main mirrors production" rule and would otherwise
# block every future push regardless of relevance).
#
# ha core check is NOT wired here -- see roadmap/plans/home-assistant-
# secrets-pipeline-PLAN.md (Plan D): it needs a secrets.yaml.example fixture
# to resolve this repo's `!secret` references, and a validated way to run
# HA's config checker on this host (no Docker/pip here, only uv/uvx).
set -euo pipefail

empty_tree=4b825dc642cb6eb9a060e54bf8d69288fbee4904
zero_sha=0000000000000000000000000000000000000000
had_error=0

while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero_sha" ] && continue  # deleting a branch, nothing to check

    if [ "$remote_sha" = "$zero_sha" ]; then
        # New branch/ref on the remote (e.g. a fresh feature branch) -- diff
        # from where it actually diverged from main, not from nothing. The
        # empty-tree fallback would otherwise flag every pre-existing file in
        # the repo as "changed" on a brand-new branch's first push.
        base="$(git merge-base main "$local_sha" 2>/dev/null || echo "$empty_tree")"
        range="$base..$local_sha"
    else
        range="$remote_sha..$local_sha"
    fi

    changed=()
    while IFS= read -r f; do
        [ -n "$f" ] && [ -f "$f" ] && changed+=("$f")
    done < <(git diff --name-only "$range" -- '*.yaml' '*.yml' 2>/dev/null || true)

    [ "${#changed[@]}" -eq 0 ] && continue

    echo "pre-push: yamllint on ${#changed[@]} changed file(s)..."
    if ! uvx yamllint -c .yamllint "${changed[@]}"; then
        had_error=1
    fi
done

if [ "$had_error" -ne 0 ]; then
    echo "pre-push: yamllint failed -- push aborted. Fix the above and retry." >&2
    exit 1
fi

exit 0
