# secrets.yaml.example -- fictional values, safe to commit.
#
# The real secrets.yaml is gitignored and is never committed. This file exists
# so local validation can resolve every `!secret` reference in this repo, and as
# the list of keys the config uses. Every uncommented `!secret <name>` in the
# YAML needs an entry here; the pre-push hook rejects a push that references a
# key this file lacks.
#
# Real values are supplied out-of-band, not from this repository.

PDU_IPv4: "10.0.0.20"
PDU_community: "example-snmp-community"
Pioneer_IPv4: "10.0.0.21"
Duo_IPv4: "10.0.0.22"
Duo_user: "example-user"
Duo_password: "example-password"
Duo_pin: "0000"
